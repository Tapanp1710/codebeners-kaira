# =====================================================================================
# KAIRA backend environment template.
# Copy to .env (scripts/setup does this for you and generates JWT_SECRET_KEY).
# Never commit .env. Full reference: docs/ENVIRONMENT_SETUP.md
# =====================================================================================

# --- Application ---------------------------------------------------------------------
APP_NAME=KAIRA
# development | test | staging | production  (staging/production enforce secure settings)
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
API_V1_PREFIX=/api/v1
# Apply Alembic migrations automatically when the API starts (dev containers only).
RUN_MIGRATIONS_ON_START=false

# --- Database ------------------------------------------------------------------------
# Host-run API (venv) talking to the docker compose database:
DATABASE_URL=postgresql+psycopg://kaira:kaira_dev_password@127.0.0.1:5432/kaira
# (docker compose overrides this to use host "db" for the api container.)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
# Used by docker-compose.yml for the local database container only.
POSTGRES_USER=kaira
POSTGRES_PASSWORD=kaira_dev_password
POSTGRES_DB=kaira
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
# Optional: test database (defaults to DATABASE_URL with database name kaira_test).
# TEST_DATABASE_URL=postgresql+psycopg://kaira:kaira_dev_password@127.0.0.1:5432/kaira_test

# --- Business defaults ---------------------------------------------------------------
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
# Days after "today" at which an overdue, uncommitted invoice is assumed to be collected.
DEFAULT_OVERDUE_COLLECTION_DELAY_DAYS=30

# --- Authentication ------------------------------------------------------------------
# REQUIRED in staging/production (>= 32 chars). scripts/setup generates one for development.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Must be true in staging/production (HTTPS only cookies).
COOKIE_SECURE=false
# lax for same-site deployments (localhost:3000 -> localhost:8000, app.x.com -> api.x.com).
# none (+ COOKIE_SECURE=true) only when frontend and backend are on different sites.
COOKIE_SAMESITE=lax
# Optional, e.g. .example.com to share cookies between app. and api. subdomains.
COOKIE_DOMAIN=

# --- CORS ----------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated list of browser origins allowed to call the API with credentials.
# Add a LAN origin such as http://192.168.1.20:3000 when the frontend runs on another laptop.
CORS_ORIGINS=http://localhost:3000

# --- Request protection --------------------------------------------------------------
MAX_REQUEST_BYTES=1000000
MAX_AUDIO_UPLOAD_BYTES=5000000
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_PAYMENT_PER_MINUTE=60
# postgres: shared by all workers/containers (default). memory: single process only.
RATE_LIMIT_BACKEND=postgres
RATE_LIMIT_AI_PER_MINUTE=30

# --- Sarvam AI (optional: dashboard and typed workflows run without it) ----------------
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
# Speech-to-text (Saaras). saaras:v4 is the current recommended model.
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=transcribe
# Chat completions model used for structured extraction.
SARVAM_LLM_MODEL=sarvam-105b
# none | low | medium | high  (blank = provider default)
SARVAM_LLM_REASONING_EFFORT=low
SARVAM_LLM_MAX_TOKENS=4096
# Text-to-speech (Bulbul). Speakers must belong to the chosen model.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER_TE=shubh
SARVAM_TTS_SPEAKER_HI=shubh
SARVAM_TTS_SPEAKER_EN=shubh
# 0.5 - 2.0
SARVAM_TTS_PACE=1.0
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_CODEC=wav
SARVAM_TIMEOUT_SECONDS=60
SARVAM_MAX_RETRIES=2
# auto (Sarvam when SARVAM_API_KEY is set, otherwise deterministic English rules) | sarvam | rules
AI_EXTRACTION_PROVIDER=auto

# --- Demo seed (development only) ----------------------------------------------------
DEMO_OWNER_EMAIL=demo@kaira.local
# scripts/setup generates one if blank and prints it once.
DEMO_OWNER_PASSWORD=

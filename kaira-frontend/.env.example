# KAIRA frontend configuration. Copy to .env.local (scripts/setup does this).
# Nothing secret belongs here: no database credentials, no Sarvam keys.

# Public, safe to expose to the browser.
NEXT_PUBLIC_APP_NAME=KAIRA
NEXT_PUBLIC_APP_ENV=development

# SERVER-ONLY. Where the Next.js server reaches the KAIRA backend (no /api/v1 suffix).
# The browser never sees this value; it talks to /api/backend/* on this app.
#   Same machine as the backend:      http://127.0.0.1:8000
#   Backend on another laptop (LAN):  http://<backend-laptop-private-ip>:8000
#   Staging / production:             https://api.example.com
BACKEND_ORIGIN=http://127.0.0.1:8000

# Optional: upstream timeout for proxied backend calls, in milliseconds (default 30000; audio uses 90000).
BACKEND_TIMEOUT_MS=30000
# Header set by YOUR reverse proxy carrying the browser's IP (e.g. x-real-ip). Leave unset unless every
# request reaches Next through that proxy; browser-supplied X-Forwarded-For is never trusted or forwarded.
# TRUSTED_CLIENT_IP_HEADER=

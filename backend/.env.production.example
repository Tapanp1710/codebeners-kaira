# KAIRA backend - production environment template (copy to .env.production or set in your host).
# Startup FAILS if security-critical values are missing or weak.
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
# false when the host runs `python -m app.cli migrate` as a pre-deploy/release command.
# true on hosts without one (e.g. the Render free plan): the entrypoint migrates before starting.
RUN_MIGRATIONS_ON_START=false

# Managed PostgreSQL connection string (never the development password). For Supabase use the session pooler
# (port 5432) connection string with the postgresql+psycopg:// scheme and ?sslmode=require.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_OVERDUE_COLLECTION_DELAY_DAYS=30

# >= 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true
# lax when frontend and API share a registrable domain (app.example.com + api.example.com);
# none only when they are on different sites (requires COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

FRONTEND_ORIGIN=https://app.example.com
CORS_ORIGINS=https://app.example.com

MAX_REQUEST_BYTES=1000000
MAX_AUDIO_UPLOAD_BYTES=5000000
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_PAYMENT_PER_MINUTE=60
# postgres: shared by all workers/containers (default). memory: single process only.
RATE_LIMIT_BACKEND=postgres
RATE_LIMIT_AI_PER_MINUTE=30
# Container entrypoint only (docker/entrypoint.sh).
# Proxy IPs whose X-Forwarded-* headers are trusted by uvicorn (your load balancer).
FORWARDED_ALLOW_IPS=127.0.0.1
# Number of uvicorn worker processes. The WebSocket ticket single-use check and the one-live-socket-per-user
# rule are kept per process, so keep 1 unless those checks move to a shared store.
WEB_CONCURRENCY=1
# PORT is usually set by the host (default 8000).

SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=transcribe
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_LLM_REASONING_EFFORT=low
SARVAM_LLM_MAX_TOKENS=4096
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER_TE=kavitha_te_conversation
SARVAM_TTS_SPEAKER_HI=aparna_hi_customer
SARVAM_TTS_SPEAKER_EN=aparna_en_companion
SARVAM_TTS_PACE=1.0
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_CODEC=wav
SARVAM_TIMEOUT_SECONDS=60
SARVAM_MAX_RETRIES=2
AI_EXTRACTION_PROVIDER=auto

# Live voice agent. Browsers connect to this WebSocket URL directly (Next.js cannot proxy WebSockets), so it must be
# the public wss:// address of this API, and the frontend's origin must be in CORS_ORIGINS.
AGENT_PUBLIC_WS_URL=wss://<your-render-service>.onrender.com/api/v1/agent/live
# auto: clear, evidenced owner instructions execute; confirm: every write waits for a "yes".
AGENT_AUTONOMY=auto
AGENT_STT_LANGUAGE=auto
AGENT_STT_STREAM_TYPE=fast
AGENT_VAD_THRESHOLD=0.3
AGENT_VAD_SILENCE_MS=900
AGENT_VAD_PREFIX_PADDING_MS=300
AGENT_VAD_MIN_SPEECH_MS=250
AGENT_TTS_SAMPLE_RATE=22050
AGENT_MAX_TOOL_STEPS=6
AGENT_TURN_TIMEOUT_SECONDS=60
AGENT_HISTORY_MESSAGES=16
AGENT_TICKET_TTL_SECONDS=60
AGENT_MAX_SESSION_MINUTES=120
